<h2>Crear Región</h2>
<form method="POST" action="/regiones/create">
  <div class="mb-3">
    <label>Nombre:</label>
    <input name="nombre" class="form-control" required>
  </div>
  <button class="btn btn-primary">Crear</button>
  <a href="/regiones" class="btn btn-secondary">Cancelar</a>
</form>
